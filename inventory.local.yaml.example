# Copy to inventory.local.yaml, replace placeholders, and chmod 0600.
# This is a private inventory template, not a deployment export.
schema: 1
updated_at: YYYY-MM-DD
last_verified_at: YYYY-MM-DD

site:
  name: example-homelab
  timezone: Etc/UTC
  base_domain: example.invalid
  proxmox:
    host: example-node
    node: example-node
    admin_user: operator
  network:
    bridge: vmbr0
    vm_storage: VM_STORAGE
    data_storage: DATA_STORAGE
  dns:
    provider: cloudflare
    proxy: false

# Every managed service should carry this shape in the services map.
service_schema:
  vm_id: next-free
  hostname: example-service
  admin_user: operator
  network:
    exposure: tailscale-private
    caddy_bind: tailscale-ipv4
    cloudflare_proxy: false
    public_ingress: false
  application:
    compose_directory: /opt/example-service
    image: vendor/example-service
    channel: stable
    internal_port: 8080
    health_path: /health
  storage:
    mount: /srv/example-service-data
    persistent_paths: []
  encryption:
    method: none
    unlock: none
    key_reference: "<external protected reference or null>"
    agent_key_delivery:
      provider: "<vaultwarden or null>"
      collection: "<agent-managed collection or null>"
      item: "<exact vault item name or null>"
      encoding: "<base64 or null>"
      expected_decoded_bytes: null
      local_recovery_copy: retained-until-explicit-approval
      round_trip_test: pending
      luks_header_test: pending
    recovery_passphrase: "<external protected reference or null>"
    header_backup: false
    unattended_boot: true
  updates:
    channel: stable
    schedule: daily-03:00-local
    healthcheck_after_update: true
  backups:
    enabled: false
    method: deferred
    external_disaster_recovery: false
  handoff:
    owner_setup: pending-operator

services:
  example-service:
    vm_id: next-free
    hostname: example-service
    admin_user: operator
    network:
      exposure: tailscale-private
      caddy_bind: tailscale-ipv4
      cloudflare_proxy: false
      public_ingress: false
    application:
      compose_directory: /opt/example-service
      image: vendor/example-service
      channel: stable
      internal_port: 8080
      health_path: /health
    storage:
      mount: /srv/example-service-data
      persistent_paths: []
    encryption:
      method: none
      unlock: none
      key_reference: "<external protected reference or null>"
      agent_key_delivery:
        provider: "<vaultwarden or null>"
        collection: "<agent-managed collection or null>"
        item: "<exact vault item name or null>"
        encoding: "<base64 or null>"
        expected_decoded_bytes: null
        local_recovery_copy: retained-until-explicit-approval
        round_trip_test: pending
        luks_header_test: pending
      recovery_passphrase: "<external protected reference or null>"
      header_backup: false
      unattended_boot: true
    updates:
      channel: stable
      schedule: daily-03:00-local
      healthcheck_after_update: true
    backups:
      enabled: false
      method: deferred
      external_disaster_recovery: false
    handoff:
      owner_setup: pending-operator

  vaultwarden:
    vm_id: next-free
    hostname: vaultwarden.example.invalid
    admin_user: operator
    network:
      exposure: tailscale-private
      caddy_bind: tailscale-ipv4
      cloudflare_proxy: false
      public_ingress: false
      smtp: compose-network-only
    urls:
      app: https://vaultwarden.example.invalid
      mailpit_ui: https://mail.vaultwarden.example.invalid
      mailpit_parent: vaultwarden.example.invalid
    application:
      compose_directory: /srv/vaultwarden-data/app
      image: vaultwarden/server
      channel: stable
      internal_port: 80
      health_path: /alive
      registration:
        bootstrap:
          signups_allowed: true
          signups_verify: true
          signups_domains_whitelist: ""
        final:
          signups_allowed: false
          signups_verify: true
          signups_domains_whitelist: ""
        invitations_allowed: true
        verify: real-verification-email-and-owner-login
        backend_rejection_check: required
        existing_owner_login_check: required
        form_may_remain_visible_when_blocked: true
        apply_method: recreate-vaultwarden-only
        temporary_reopen_sequence: true-recreate-onboard-false-recreate
        config_source: protected-environment-authoritative
        admin_ui_config_path: /data/config.json
        whitelist_overrides_signups_allowed: true
        invitation_diagnosis:
          nonexistent_account_error: User does not exist
          diagnose_running_container_policy: true
          fix_signups_allowed: false
          fix_invitations_allowed: true
          fix_apply_method: recreate-vaultwarden-only
          verify_running_policy: false:true
          verify_health: required
          normal_flow_admin_ui_invite_required: false
          normal_flow_direct_database_write_required: false
    mailpit:
      parent_service: vaultwarden
      ui_hostname: mail.vaultwarden.example.invalid
      smtp_capture: internal-compose-service
      smtp_auth: none
      ui_private_https: true
      ui_auth: caddy-basic
    storage:
      mount: /srv/vaultwarden-data
      persistent_paths:
        - /srv/vaultwarden-data/app
        - /srv/vaultwarden-data/docker
        - /srv/vaultwarden-data/secrets
      rollback_retention: 7
      external_disaster_recovery: false
    encryption:
      method: guest-luks-data
      mapper: vaultwarden-data
      unlock: local-helper-over-stdin
      key_reference: "<external protected file reference>"
      recovery_passphrase: "<external protected recovery reference>"
      header_backup: true
      unattended_boot: false
    updates:
      channel: stable
      schedule: daily-03:00-local
      healthcheck_after_update: true
    backups:
      enabled: true
      method: same-disk-encrypted-rollback
      external_disaster_recovery: false
    handoff:
      owner_setup: pending-operator
      signup_policy: pending-operator

# Vaultwarden is the primary store only after bootstrap. Its own recovery
# material must stay outside it so the service can be unlocked first.
vaultwarden_credential_provider:
  bootstrap:
    method: local-files
    secret_references:
      owner_bootstrap: "<protected local file reference>"
      application_admin: "<protected local file reference>"
      smtp_capture: "<protected local file reference>"
      cloudflare_api_token: "<external file reference>"
  primary_store_after_bootstrap: vaultwarden
  authoritative_luks_recovery:
    location: outside-vaultwarden
    reference: "<external protected recovery location>"
  gopass_adapter: optional-future-not-implemented

agent_access:
  accounts:
    example-host:
      hostname: agent-host.example.invalid
      email: agent-host@example.invalid
      role: user
      access_all: false
      collection: Agent Managed
      permissions: read-write-no-manage
      credential_file: "<protected local file reference>"
      bootstrap_store: protected-local-file
      invitation_state: confirmed
      cli_server: https://vaultwarden.example.invalid
      scope_test: passed

publication:
  denylist_file: .publication-denylist
  scan_tracked_content_before_publish: true

# Upstream semantics: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template
# and https://github.com/dani-garcia/vaultwarden/blob/main/src/config.rs
